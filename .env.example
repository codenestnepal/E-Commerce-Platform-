# Nile E-Commerce Platform - Environment Variables Template
# Copy this file to .env (or backend/.env) and customize values

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Database URI (Local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/nile_ecommerce

# JSON Web Token Secret
JWT_SECRET=supersecretjwtkey_nile123_change_in_production

# Admin Bypass for Local Testing (Set to false in production)
ALLOW_ANONYMOUS_ADMIN=true

# Razorpay Payment Gateway (Optional for online cards/UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / SMTP Configuration (Optional for Password Reset & Inquiries)
EMAIL_USER=support@nile.com
EMAIL_PASS=password
ADMIN_EMAIL=admin@nile.com

# Cloudinary Storage (Optional for cloud media uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
